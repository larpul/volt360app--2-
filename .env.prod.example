# ── Solar360 production environment ──
# Copy to .env.prod and fill with real values.
# All keys are optional — the app boots without them; features report "not configured".

# Google AI (Gemini) — powers the AI Assistant, roof scan, bill analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Maps / Solar API — roof data and satellite tiles (also sent to browser for maps)
GOOGLE_MAPS_API_KEY=
# Optional separate key for the server-side Solar API (defaults to GOOGLE_MAPS_API_KEY)
# GOOGLE_SOLAR_API_KEY=

# Resend — booking notification emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=Digital Card <onboarding@resend.dev>
NOTIFICATION_EMAIL=

# Google Sheets — scan/share logging
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_TAB=Scans
